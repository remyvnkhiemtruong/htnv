{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "sin1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/student/overview",
      "destination": "/api/academic/snapshot?scope=student-overview"
    },
    {
      "source": "/api/student/workspace",
      "destination": "/api/academic/snapshot?scope=student-workspace"
    },
    {
      "source": "/api/teacher/overview",
      "destination": "/api/academic/snapshot?scope=teacher-overview"
    },
    {
      "source": "/api/teacher/workspace",
      "destination": "/api/academic/snapshot?scope=teacher-workspace"
    },
    {
      "source": "/api/teacher/literature",
      "destination": "/api/academic/snapshot?scope=teacher-literature"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
